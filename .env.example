# Copia a .env.local (dev) y configura los mismos en Vercel (producción).
# NUNCA commitees valores reales. .env.local está en .gitignore.

# Panel editorial
ADMIN_PASSWORD=          # contraseña de login del panel /admin
ADMIN_SECRET=            # secreto para firmar el JWT de sesión (string largo y aleatorio)

# GitHub (para que el panel commitee y Vercel redepliegue). Vacío en dev = filesystem local.
GITHUB_TOKEN=            # token con permiso Contents: read/write sobre el repo
GITHUB_OWNER=marketingianews-coder
GITHUB_REPO=santiagopost
GITHUB_BRANCH=main

# IA (agente de contenido)
ANTHROPIC_API_KEY=
